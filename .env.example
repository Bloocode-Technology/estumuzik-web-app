# Copy to .env for local Docker builds. Never commit a filled .env.
# In production, set these in Coolify (build-time + runtime).

# Backend API base URL
NEXT_PUBLIC_BACK_URL=
# Public URL of this frontend (the final Coolify domain)
NEXT_PUBLIC_FRONT_URL=
# Base URL for WordPress-hosted images
NEXT_PUBLIC_WP_IMAGE_URL=
